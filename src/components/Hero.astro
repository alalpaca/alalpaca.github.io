---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 -z-10">
    <div class="absolute top-20 left-10 h-72 w-72 rounded-full bg-primary-50 opacity-60 blur-3xl"></div>
    <div class="absolute bottom-20 right-10 h-96 w-96 rounded-full bg-blue-50 opacity-40 blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[600px] w-[600px] rounded-full bg-gradient-to-br from-primary-25 to-transparent opacity-30 blur-3xl"></div>
  </div>

  <div class="container-custom pt-32 pb-20">
    <div class="max-w-3xl">
      <!-- Greeting -->
      <p class="mb-4 text-sm font-medium uppercase tracking-widest text-primary-600 opacity-0 animate-fade-in" style="animation-delay: 0.2s;">
        {t('hero.greeting')}
      </p>

      <!-- Name -->
      <h1 class="heading-1 mb-6 opacity-0 animate-slide-up" style="animation-delay: 0.4s;">
        <span class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-600 bg-clip-text text-transparent">
          {t('hero.name')}
        </span>
      </h1>

      <!-- Title -->
      <p class="mb-6 text-xl font-medium text-gray-500 sm:text-2xl opacity-0 animate-slide-up" style="animation-delay: 0.6s;">
        {t('hero.title')}
      </p>

      <!-- Description -->
      <p class="mb-10 max-w-xl text-body opacity-0 animate-slide-up" style="animation-delay: 0.8s;">
        {t('hero.description')}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4 opacity-0 animate-slide-up" style="animation-delay: 1s;">
        <a href={`/${lang}/projects`} class="btn-primary">
          {t('hero.cta')}
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
          </svg>
        </a>
        <a href="mailto:yunfeiwa@usc.edu" class="btn-secondary">
          {t('hero.contact')}
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 opacity-0 animate-fade-in" style="animation-delay: 1.5s;">
      <div class="flex flex-col items-center gap-2 text-gray-400">
        <span class="text-xs font-medium uppercase tracking-widest">Scroll</span>
        <div class="h-10 w-px bg-gradient-to-b from-gray-300 to-transparent animate-pulse"></div>
      </div>
    </div>
  </div>
</section>
