---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import SplitText from './SplitText';
import GradientText from './GradientText';
import BlurText from './BlurText';
import LiquidEther from './LiquidEther';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Liquid Ether background -->
  <div class="absolute inset-0 -z-10" style="opacity: 0.6;">
    <LiquidEther
      client:load
      colors={['#93c5fd', '#60a5fa', '#dbeafe']}
      mouseForce={15}
      cursorSize={100}
      resolution={0.4}
      autoDemo={true}
      autoSpeed={0.3}
      autoIntensity={1.5}
      autoResumeDelay={1000}
      autoRampDuration={0.6}
      className="w-full h-full"
      style={{ position: 'absolute', inset: 0 }}
    />
  </div>

  <div class="container-custom pt-32 pb-20">
    <div class="max-w-4xl">
      <!-- Greeting -->
      <p class="mb-6 text-base font-medium uppercase tracking-widest text-primary-600 opacity-0 animate-fade-in" style="animation-delay: 0.4s; animation-duration: 1.2s;">
        {t('hero.greeting')}
      </p>

      <!-- Name with SplitText animation -->
      <h1 class="text-5xl font-bold sm:text-6xl md:text-7xl mb-8 overflow-visible leading-normal text-gray-900">
        <SplitText
          client:load
          text={t('hero.name')}
          delay={0.8}
        />
      </h1>

      <!-- Title with GradientText animation -->
      <div class="mb-8 text-2xl font-medium sm:text-3xl overflow-visible opacity-0 animate-slide-up" style="animation-delay: 3.5s; animation-duration: 1.2s;">
        <GradientText client:load>
          {t('hero.title')}
        </GradientText>
      </div>

      <!-- Description with BlurText animation -->
      <div class="mb-12 max-w-2xl">
        <BlurText
          client:load
          text={t('hero.description')}
          className="text-lg leading-relaxed text-gray-600 sm:text-xl"
          delay={4.5}
        />
      </div>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4 opacity-0 animate-slide-up" style="animation-delay: 6.0s; animation-duration: 1.2s;">
        <a href={`/${lang}/projects`} class="btn-primary">
          {t('hero.cta')}
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
          </svg>
        </a>
        <a href="mailto:yunfeiwa@usc.edu" class="btn-secondary">
          {t('hero.contact')}
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 opacity-0 animate-fade-in" style="animation-delay: 7.0s; animation-duration: 1.5s;">
      <div class="flex flex-col items-center gap-2 text-gray-400">
        <span class="text-xs font-medium uppercase tracking-widest">Scroll</span>
        <div class="h-10 w-px bg-gradient-to-b from-gray-300 to-transparent animate-pulse"></div>
      </div>
    </div>
  </div>
</section>
