---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ScrollReveal from '../../components/ScrollReveal';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('zh');

const featuredProjects = [
  {
    title: '项目 Alpha',
    description: '使用现代技术构建的全栈 Web 应用，具有实时数据可视化和协作编辑功能。',
    tags: ['React', 'Node.js', 'PostgreSQL'],
    projectUrl: '#',
    codeUrl: '#',
  },
  {
    title: '项目 Beta',
    description: '移动优先的渐进式 Web 应用，支持离线使用、推送通知和多设备同步。',
    tags: ['TypeScript', 'PWA', 'Tailwind'],
    projectUrl: '#',
    codeUrl: '#',
  },
  {
    title: '项目 Gamma',
    description: '一个自动化开发工作流的开源命令行工具，有效提升团队生产力。',
    tags: ['Python', 'CLI', '自动化'],
    projectUrl: '#',
    codeUrl: '#',
  },
];
---

<Layout title="首页 | 你的名字" description="个人作品集网站">
  <Navbar />

  <main class="flex-1">
    <!-- Hero Section -->
    <Hero />

    <!-- Featured Projects Preview -->
    <section class="section-padding bg-gray-50/50">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <div class="mb-12 text-center">
            <h2 class="heading-2 mb-3">{t('projects.title')}</h2>
            <p class="text-body">{t('projects.subtitle')}</p>
          </div>
        </ScrollReveal>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map((project, index) => (
            <ScrollReveal client:visible delay={index * 0.15} direction="up">
              <ProjectCard {...project} />
            </ScrollReveal>
          ))}
        </div>

        <ScrollReveal client:visible delay={0.4}>
          <div class="mt-10 text-center">
            <a href="/zh/projects" class="btn-secondary">
              查看全部项目
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
              </svg>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="section-padding">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="heading-2 mb-4">{t('contact.title')}</h2>
            <p class="text-body mb-8">{t('contact.description')}</p>
            <a href="mailto:your.email@example.com" class="btn-primary">
              {t('contact.email')}
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
