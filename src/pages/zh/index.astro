---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ScrollReveal from '../../components/ScrollReveal';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('zh');

const featuredProjects = [
  {
    title: 'RAG 知识库更新 Pipeline',
    description: '端到端 RAG 知识库更新流水线，集成 Power Automate 自动触发、MinerU 文档解析与 LightRAG/RAGAnything 双链路入库，支持全流程状态监控。',
    tags: ['RAG', 'LightRAG', 'Power Automate', 'SQLite'],
    projectUrl: '#',
    codeUrl: '#',
  },
  {
    title: 'PLC 报警诊断 Agent',
    description: '基于 LangGraph 的工业 PLC 报警诊断 ReAct Agent，解析 29 个子程序含 6820 条因果边，实现跨程序报警因果链自动回溯。',
    tags: ['LangGraph', 'ReAct Agent', 'Gradio', 'FastAPI'],
    projectUrl: '#',
    codeUrl: '#',
  },
  {
    title: '短期股价预测系统',
    description: '多模态股票预测框架，融合金融新闻、市场数据和技术指标，使用 FinBERT 和时序神经网络实现短期股价预测。',
    tags: ['FinBERT', 'LSTM/GRU/TCN', '多模态', '深度学习'],
    projectUrl: '#',
    codeUrl: '#',
  },
];
---

<Layout title="首页 | 王云飞" description="王云飞的个人作品集网站 - AI 工程师 & 机器学习开发者">
  <Navbar />

  <main class="flex-1">
    <!-- Hero Section -->
    <Hero />

    <!-- Featured Projects Preview -->
    <section class="section-padding bg-gray-50/50">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <div class="mb-12 text-center">
            <h2 class="heading-2 mb-3">{t('projects.title')}</h2>
            <p class="text-body">{t('projects.subtitle')}</p>
          </div>
        </ScrollReveal>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map((project, index) => (
            <ScrollReveal client:visible delay={index * 0.15} direction="up">
              <ProjectCard {...project} />
            </ScrollReveal>
          ))}
        </div>

        <ScrollReveal client:visible delay={0.4}>
          <div class="mt-10 text-center">
            <a href="/zh/projects" class="btn-secondary">
              查看全部项目
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
              </svg>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="section-padding">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="heading-2 mb-4">{t('contact.title')}</h2>
            <p class="text-body mb-8">{t('contact.description')}</p>
            <a href="mailto:yunfeiwa@usc.edu" class="btn-primary">
              {t('contact.email')}
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
