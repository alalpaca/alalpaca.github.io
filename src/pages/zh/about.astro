---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ScrollReveal from '../../components/ScrollReveal';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('zh');

const experiences = [
  {
    company: '康宁公司 (Corning Incorporated)',
    role: '数据分析工程师实习生, MT&E',
    period: '2026.05 - 2026.08',
    location: '中国上海',
    description: [
      '主导设计并实现端到端 RAG 知识库更新 Pipeline，集成 Power Automate 自动触发、MinerU 文档解析与 LightRAG/RAGAnything 双链路入库，引入 SQLite 实现全流程状态监控与错误重试；深入修改开源框架源码，实现知识库节点按文件精确删除。',
      '基于 LangGraph 构建工业 PLC 报警诊断 ReAct Agent，解析三菱 Q 系列 PLC 29 个子程序（含 6820 条因果边），实现跨程序报警因果链自动回溯至物理 I/O 层，搭配 Gradio 前端与 FastAPI 接口交付完整系统。',
      '设计 PPT One Page 文件三源融合解析方案（python-pptx + PyMuPDF + VLM），实现结构化内容 100% 精准提取并输出标准化 JSON/Markdown，为 LLM Wiki 知识库构建奠定数据基础。',
    ],
  },
  {
    company: '申万宏源证券',
    role: '机器学习工程师实习生',
    period: '2024.06 - 2024.08',
    location: '中国上海',
    description: [
      '研究并测试大语言模型（Chatglm4-9b、InternVL2-40b）在金融数据标注中的应用，使用 Postman 进行 API 接口测试。',
      '开发自动化金融数据标注解决方案，包括 Python 脚本设计、Prompt 工程和模型微调，支持后续生产部署。',
    ],
  },
  {
    company: '上海大学',
    role: '科研助理',
    period: '2023.05 - 2025.06',
    location: '中国上海',
    description: [
      '设计面向科学文献的端到端自动实体标注系统，融合基于规则的 NLP、深度学习（BiLSTM-CRF）和大模型方法（OneKE）。',
      '构建多模型集成 + 置信度融合 + RoBERTa 验证器流水线，标注精度达 ~83%，使用 Django 和 Vue3 部署为生产系统。',
    ],
  },
];

const skills = [
  { category: 'AI / ML', items: ['Python', 'PyTorch', 'LangGraph', 'RAG', 'NLP', '深度学习', 'LLM', 'FinBERT'] },
  { category: '前端', items: ['JavaScript', 'HTML', 'CSS', 'Vue3', 'React', 'Gradio'] },
  { category: '后端', items: ['FastAPI', 'Django', 'Node.js', 'SQLite', 'PostgreSQL'] },
  { category: '工具 & 系统', items: ['Git', 'Linux', 'Docker', 'MATLAB', 'C++', 'Power Automate'] },
];

const education = [
  {
    school: '南加州大学 (USC)',
    degree: '计算机科学硕士（人工智能方向）',
    period: '2025.09 - 2027.05',
    gpa: 'GPA: 3.82/4.0',
  },
  {
    school: '上海大学',
    degree: '人工智能学士',
    period: '2021.09 - 2025.06',
    gpa: 'GPA: 3.45/4.0',
  },
];

const honors = [
  { title: '金奖', org: '中国国际大学生创新大赛', year: '2024' },
  { title: 'Meritorious Winner', org: '美国大学生数学建模竞赛 (MCM)', year: '2023' },
  { title: '二等奖', org: '第24届中国机器人及人工智能大赛', year: '2022' },
  { title: '论文发表', org: 'arXiv:2505.19879 - 基于 N1 和 LPP 成分的人类偏好研究', year: '2025' },
  { title: '软件著作权', org: '文献信息自动标注与挖掘平台 V1.0', year: '2024' },
  { title: '奖学金', org: '领导力奖学金、学业优秀奖学金、自强不息奖学金', year: '2021-2025' },
];
---

<Layout title="关于我 | 王云飞" description="了解更多关于王云飞的信息 - AI/ML 工程师，工作经历、技能和教育背景">
  <Navbar />

  <main class="flex-1 pt-20 md:pt-24">
    <!-- Header -->
    <section class="section-padding pb-12">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <div class="max-w-2xl">
            <h1 class="heading-1 mb-4">{t('about.title')}</h1>
            <p class="text-body text-lg">{t('about.intro')}</p>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <!-- Experience -->
    <section class="pb-16 md:pb-20">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <h2 class="heading-2 mb-8">{t('about.experience.title')}</h2>
        </ScrollReveal>

        <div class="space-y-8">
          {experiences.map((exp, index) => (
            <ScrollReveal client:visible delay={index * 0.15} direction="left">
              <div class="card">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-3">
                  <div>
                    <h3 class="text-lg font-semibold text-gray-900">{exp.role}</h3>
                    <p class="text-sm font-medium text-primary-600">{exp.company}</p>
                  </div>
                  <div class="mt-1 sm:mt-0 sm:text-right">
                    <p class="text-sm text-gray-400">{exp.period}</p>
                    <p class="text-xs text-gray-400">{exp.location}</p>
                  </div>
                </div>
                <ul class="space-y-2">
                  {exp.description.map((item) => (
                    <li class="text-sm text-gray-500 leading-relaxed pl-4 relative before:absolute before:left-0 before:top-2 before:h-1.5 before:w-1.5 before:rounded-full before:bg-primary-300">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section class="section-padding bg-gray-50/50">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <h2 class="heading-2 mb-10">{t('about.skills.title')}</h2>
        </ScrollReveal>

        <div class="grid gap-6 sm:grid-cols-2">
          {skills.map((skill, index) => (
            <ScrollReveal client:visible delay={index * 0.1} direction="up">
              <div class="card">
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-400">
                  {skill.category}
                </h3>
                <div class="flex flex-wrap gap-2">
                  {skill.items.map((item) => (
                    <span class="rounded-full bg-primary-50 px-3 py-1.5 text-sm font-medium text-primary-700">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Education -->
    <section class="section-padding">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <h2 class="heading-2 mb-8">{t('about.education.title')}</h2>
        </ScrollReveal>

        <div class="space-y-6">
          {education.map((edu, index) => (
            <ScrollReveal client:visible delay={index * 0.15} direction="up">
              <div class="card">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <h3 class="text-lg font-semibold text-gray-900">{edu.degree}</h3>
                    <p class="text-sm font-medium text-primary-600">{edu.school}</p>
                  </div>
                  <div class="mt-1 sm:mt-0 sm:text-right">
                    <p class="text-sm text-gray-400">{edu.period}</p>
                    <p class="text-sm font-medium text-gray-500">{edu.gpa}</p>
                  </div>
                </div>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Honors & Awards -->
    <section class="section-padding bg-gray-50/50">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <h2 class="heading-2 mb-8">荣誉与奖项</h2>
        </ScrollReveal>

        <div class="grid gap-4 sm:grid-cols-2">
          {honors.map((honor, index) => (
            <ScrollReveal client:visible delay={index * 0.1} direction="up">
              <div class="card">
                <div class="flex items-start justify-between">
                  <div>
                    <h3 class="text-base font-semibold text-gray-900">{honor.title}</h3>
                    <p class="mt-1 text-sm text-gray-500">{honor.org}</p>
                  </div>
                  <span class="shrink-0 ml-3 rounded-full bg-primary-50 px-2.5 py-0.5 text-xs font-medium text-primary-700">
                    {honor.year}
                  </span>
                </div>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
