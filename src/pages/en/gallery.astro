---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Gallery from '../../components/Gallery';
import ScrollReveal from '../../components/ScrollReveal';
import { useTranslations } from '../../i18n/utils';
import { galleryImages, categoryLabels } from '../../data/gallery';

const t = useTranslations('en');

const images = galleryImages.map((img) => ({
  src: img.src,
  alt: img.category,
  category: categoryLabels[img.category].en,
}));

const categories = Object.values(categoryLabels)
  .map((label) => label.en)
  .filter((label) => images.some((img) => img.category === label));
---

<Layout title="Gallery | Felix Wang" description="Photo gallery - moments captured through my lens">
  <Navbar />

  <main class="flex-1 pt-20 md:pt-24">
    <section class="section-padding">
      <div class="container-custom">
        <!-- Header -->
        <ScrollReveal client:visible>
          <div class="mb-12 text-center">
            <h1 class="heading-1 mb-4">{t('gallery.title')}</h1>
            <p class="text-body">{t('gallery.subtitle')}</p>
          </div>
        </ScrollReveal>

        <!-- Gallery Component -->
        <ScrollReveal client:visible delay={0.2}>
          <Gallery client:visible images={images} categories={categories} />
        </ScrollReveal>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
