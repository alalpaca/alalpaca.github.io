---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Gallery from '../../components/Gallery';
import ScrollReveal from '../../components/ScrollReveal';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');

// Placeholder images using picsum.photos (replace with your own images)
const images = [
  { src: 'https://picsum.photos/seed/photo1/600/400', alt: 'Landscape photography', category: 'Travel' },
  { src: 'https://picsum.photos/seed/photo2/600/800', alt: 'City skyline at dusk', category: 'Travel' },
  { src: 'https://picsum.photos/seed/photo3/600/500', alt: 'Mountain hiking trail', category: 'Nature' },
  { src: 'https://picsum.photos/seed/photo4/600/600', alt: 'Coffee and coding setup', category: 'Life' },
  { src: 'https://picsum.photos/seed/photo5/600/450', alt: 'Sunset over the ocean', category: 'Nature' },
  { src: 'https://picsum.photos/seed/photo6/600/700', alt: 'Street photography', category: 'Travel' },
  { src: 'https://picsum.photos/seed/photo7/600/400', alt: 'Home workspace setup', category: 'Life' },
  { src: 'https://picsum.photos/seed/photo8/600/550', alt: 'Forest path in autumn', category: 'Nature' },
  { src: 'https://picsum.photos/seed/photo9/600/650', alt: 'Cooking in the kitchen', category: 'Life' },
];

const categories = ['Travel', 'Nature', 'Life'];
---

<Layout title="Gallery | Your Name" description="Photo gallery - moments captured through my lens">
  <Navbar />

  <main class="flex-1 pt-20 md:pt-24">
    <section class="section-padding">
      <div class="container-custom">
        <!-- Header -->
        <ScrollReveal client:visible>
          <div class="mb-12 text-center">
            <h1 class="heading-1 mb-4">{t('gallery.title')}</h1>
            <p class="text-body">{t('gallery.subtitle')}</p>
          </div>
        </ScrollReveal>

        <!-- Gallery Component -->
        <ScrollReveal client:visible delay={0.2}>
          <Gallery client:visible images={images} categories={categories} />
        </ScrollReveal>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
