---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ScrollReveal from '../../components/ScrollReveal';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');

const experiences = [
  {
    company: 'Corning Incorporated',
    role: 'Data Analytics Engineer Intern, MT&E',
    period: 'May 2026 - Aug 2026',
    location: 'Shanghai, China',
    description: [
      'Designed and implemented an end-to-end RAG knowledge base update pipeline, integrating Power Automate triggers, MinerU document parsing, and LightRAG/RAGAnything dual-path ingestion with SQLite for full-process state monitoring and error retry.',
      'Built an industrial PLC alarm diagnosis ReAct Agent using LangGraph, parsing 29 subroutines (6,820 causal edges) of Mitsubishi Q-series PLCs with Gradio frontend and FastAPI backend.',
      'Designed a three-source PPT parsing solution (python-pptx + PyMuPDF + VLM) achieving 100% accurate structured content extraction for LLM Wiki knowledge base construction.',
    ],
  },
  {
    company: 'ShenwanHongyuan Securities',
    role: 'Machine Learning Engineer Intern',
    period: 'Jun 2024 - Aug 2024',
    location: 'Shanghai, China',
    description: [
      'Researched and tested LLM models (Chatglm4-9b, InternVL2-40b) for financial data labeling, conducting API testing with Postman.',
      'Developed automated financial data tagging solutions including Python scripts, prompt engineering, and model fine-tuning for production deployment.',
    ],
  },
  {
    company: 'Shanghai University',
    role: 'Research Assistant',
    period: 'May 2023 - Jun 2025',
    location: 'Shanghai, China',
    description: [
      'Designed an end-to-end automated entity annotation system for scientific literature, integrating rule-based NLP, deep learning (BiLSTM-CRF), and LLM-based methods (OneKE).',
      'Built a multi-model ensemble with confidence fusion and RoBERTa-based verifier achieving ~83% annotation precision, deployed with Django and Vue3.',
    ],
  },
];

const skills = [
  { category: 'AI / ML', items: ['Python', 'PyTorch', 'LangGraph', 'RAG', 'NLP', 'Deep Learning', 'LLM', 'FinBERT'] },
  { category: 'Frontend', items: ['JavaScript', 'HTML', 'CSS', 'Vue3', 'React', 'Gradio'] },
  { category: 'Backend', items: ['FastAPI', 'Django', 'Node.js', 'SQLite', 'PostgreSQL'] },
  { category: 'Tools & Systems', items: ['Git', 'Linux', 'Docker', 'MATLAB', 'C++', 'Power Automate'] },
];

const education = [
  {
    school: 'University of Southern California (USC)',
    degree: 'M.S. in Computer Science (Artificial Intelligence)',
    period: 'Sep 2025 - May 2027',
    gpa: 'GPA: 3.82/4.0',
  },
  {
    school: 'Shanghai University (SHU)',
    degree: 'B.S. in Artificial Intelligence',
    period: 'Sep 2021 - Jun 2025',
    gpa: 'GPA: 3.45/4.0',
  },
];

const honors = [
  { title: 'Gold Medal', org: 'China International Collegiate Innovation Competition', year: '2024' },
  { title: 'Meritorious Winner', org: 'Mathematical Contest in Modeling (MCM)', year: '2023' },
  { title: '2nd Place', org: 'The 24th China Robot and Artificial Intelligence Competition', year: '2022' },
  { title: 'Published Paper', org: 'arXiv:2505.19879 - Study of Human Preference Based on N1 and LPP Components', year: '2025' },
  { title: 'Software Copyright', org: 'Automatic Annotation and Mining Platform for Literature Information V1.0', year: '2024' },
  { title: 'Scholarships', org: 'Leadership Scholar, Academic Excellence Scholar, Perseverance Scholar', year: '2021-2025' },
];
---

<Layout title="About | Felix Wang" description="Learn more about Felix Wang - AI/ML engineer, experience, skills, and education">
  <Navbar />

  <main class="flex-1 pt-20 md:pt-24">
    <!-- Header -->
    <section class="section-padding pb-12">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <div class="max-w-2xl">
            <h1 class="heading-1 mb-4">{t('about.title')}</h1>
            <p class="text-body text-lg">{t('about.intro')}</p>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <!-- Experience -->
    <section class="pb-16 md:pb-20">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <h2 class="heading-2 mb-8">{t('about.experience.title')}</h2>
        </ScrollReveal>

        <div class="space-y-8">
          {experiences.map((exp, index) => (
            <ScrollReveal client:visible delay={index * 0.15} direction="left">
              <div class="card">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-3">
                  <div>
                    <h3 class="text-lg font-semibold text-gray-900">{exp.role}</h3>
                    <p class="text-sm font-medium text-primary-600">{exp.company}</p>
                  </div>
                  <div class="mt-1 sm:mt-0 sm:text-right">
                    <p class="text-sm text-gray-400">{exp.period}</p>
                    <p class="text-xs text-gray-400">{exp.location}</p>
                  </div>
                </div>
                <ul class="space-y-2">
                  {exp.description.map((item) => (
                    <li class="text-sm text-gray-500 leading-relaxed pl-4 relative before:absolute before:left-0 before:top-2 before:h-1.5 before:w-1.5 before:rounded-full before:bg-primary-300">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section class="section-padding bg-gray-50/50">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <h2 class="heading-2 mb-10">{t('about.skills.title')}</h2>
        </ScrollReveal>

        <div class="grid gap-6 sm:grid-cols-2">
          {skills.map((skill, index) => (
            <ScrollReveal client:visible delay={index * 0.1} direction="up">
              <div class="card">
                <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-gray-400">
                  {skill.category}
                </h3>
                <div class="flex flex-wrap gap-2">
                  {skill.items.map((item) => (
                    <span class="rounded-full bg-primary-50 px-3 py-1.5 text-sm font-medium text-primary-700">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Education -->
    <section class="section-padding">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <h2 class="heading-2 mb-8">{t('about.education.title')}</h2>
        </ScrollReveal>

        <div class="space-y-6">
          {education.map((edu, index) => (
            <ScrollReveal client:visible delay={index * 0.15} direction="up">
              <div class="card">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between">
                  <div>
                    <h3 class="text-lg font-semibold text-gray-900">{edu.degree}</h3>
                    <p class="text-sm font-medium text-primary-600">{edu.school}</p>
                  </div>
                  <div class="mt-1 sm:mt-0 sm:text-right">
                    <p class="text-sm text-gray-400">{edu.period}</p>
                    <p class="text-sm font-medium text-gray-500">{edu.gpa}</p>
                  </div>
                </div>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Honors & Awards -->
    <section class="section-padding bg-gray-50/50">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <h2 class="heading-2 mb-8">Honors & Awards</h2>
        </ScrollReveal>

        <div class="grid gap-4 sm:grid-cols-2">
          {honors.map((honor, index) => (
            <ScrollReveal client:visible delay={index * 0.1} direction="up">
              <div class="card">
                <div class="flex items-start justify-between">
                  <div>
                    <h3 class="text-base font-semibold text-gray-900">{honor.title}</h3>
                    <p class="mt-1 text-sm text-gray-500">{honor.org}</p>
                  </div>
                  <span class="shrink-0 ml-3 rounded-full bg-primary-50 px-2.5 py-0.5 text-xs font-medium text-primary-700">
                    {honor.year}
                  </span>
                </div>
              </div>
            </ScrollReveal>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
