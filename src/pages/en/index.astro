---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ScrollReveal from '../../components/ScrollReveal';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');

const featuredProjects = [
  {
    title: 'RAG Knowledge Base Pipeline',
    description: 'End-to-end RAG knowledge base update pipeline with Power Automate triggers, MinerU parsing, and LightRAG/RAGAnything dual-path ingestion with full-process state monitoring.',
    tags: ['RAG', 'LightRAG', 'Power Automate', 'SQLite'],
    projectUrl: '/en/projects/rag-pipeline',
    codeUrl: '#',
  },
  {
    title: 'PLC Alarm Diagnosis Agent',
    description: 'Industrial PLC alarm diagnosis ReAct Agent built with LangGraph, parsing 29 subroutines with 6,820 causal edges for automatic alarm root-cause tracing.',
    tags: ['LangGraph', 'ReAct Agent', 'Gradio', 'FastAPI'],
    projectUrl: '/en/projects/plc-agent',
    codeUrl: 'https://github.com/alalpaca/plc-alarm-diagnostic-agent',
  },
  {
    title: 'Stock Price Forecasting',
    description: 'Multimodal stock forecasting framework combining financial news, market data, and technical indicators using FinBERT and temporal neural networks.',
    tags: ['FinBERT', 'LSTM/GRU/TCN', 'Multimodal', 'Deep Learning'],
    projectUrl: '/en/projects/stock-forecasting',
    codeUrl: '#',
  },
];
---

<Layout title="Home | Felix Wang" description="Personal portfolio of Felix Wang - AI Engineer & Machine Learning Developer">
  <Navbar />

  <main class="flex-1">
    <!-- Hero Section -->
    <Hero />

    <!-- About Me Preview -->
    <section class="section-padding">
      <div class="container-custom">
        <div class="grid gap-12 lg:grid-cols-5 lg:items-center">
          <!-- Left: Text -->
          <div class="lg:col-span-3">
            <ScrollReveal client:visible>
              <h2 class="heading-2 mb-6">{t('home.about.title')}</h2>
              <p class="text-body mb-8">{t('home.about.intro')}</p>
              <div class="flex flex-wrap gap-4">
                <a href="/en/about" class="btn-primary">
                  {t('home.about.cta')}
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                  </svg>
                </a>
                <a href="/YunfeiWang_Resume.pdf" target="_blank" class="btn-secondary">
                  {t('home.about.resume')}
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                  </svg>
                </a>
              </div>
            </ScrollReveal>
          </div>

          <!-- Right: Highlights -->
          <div class="lg:col-span-2">
            <ScrollReveal client:visible delay={0.2} direction="right">
              <div class="space-y-4">
                <div class="rounded-xl border border-gray-100 bg-gray-50/50 p-5">
                  <p class="text-xs font-medium uppercase tracking-wider text-gray-400 mb-1">{t('home.about.highlight1.label')}</p>
                  <p class="text-sm font-semibold text-gray-900">{t('home.about.highlight1.value')}</p>
                </div>
                <div class="rounded-xl border border-gray-100 bg-gray-50/50 p-5">
                  <p class="text-xs font-medium uppercase tracking-wider text-gray-400 mb-1">{t('home.about.highlight2.label')}</p>
                  <p class="text-sm font-semibold text-gray-900">{t('home.about.highlight2.value')}</p>
                </div>
                <div class="rounded-xl border border-gray-100 bg-gray-50/50 p-5">
                  <p class="text-xs font-medium uppercase tracking-wider text-gray-400 mb-1">{t('home.about.highlight3.label')}</p>
                  <p class="text-sm font-semibold text-gray-900">{t('home.about.highlight3.value')}</p>
                </div>
              </div>
            </ScrollReveal>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Projects Preview -->
    <section class="section-padding">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <div class="mb-12 text-center">
            <h2 class="heading-2 mb-3">{t('projects.title')}</h2>
            <p class="text-body">{t('projects.subtitle')}</p>
          </div>
        </ScrollReveal>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featuredProjects.map((project, index) => (
            <ScrollReveal client:visible delay={index * 0.15} direction="up" className="h-full">
              <ProjectCard {...project} />
            </ScrollReveal>
          ))}
        </div>

        <ScrollReveal client:visible delay={0.4}>
          <div class="mt-10 text-center">
            <a href="/en/projects" class="btn-secondary">
              View All Projects
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
              </svg>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>

    <!-- Contact CTA -->
    <section class="section-padding">
      <div class="container-custom">
        <ScrollReveal client:visible>
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="heading-2 mb-4">{t('contact.title')}</h2>
            <p class="text-body mb-8">{t('contact.description')}</p>
            <a href="mailto:yunfeiwa@usc.edu" class="btn-primary">
              {t('contact.email')}
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </a>
          </div>
        </ScrollReveal>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
